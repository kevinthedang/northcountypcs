---
interface Props {
    heading?: string;
    text?: string;
}

const {
    heading = "Tell me what's wrong.",
    text = 'Call or email with the machine and the symptom. A photo or error message helps.',
} = Astro.props;
---

<section aria-labelledby="cta-heading">
    <div class="wrap">
        <div class="panel cta">
            <div>
                <h2 id="cta-heading">{heading}</h2>
                <p class="muted">{text}</p>
            </div>
            <div class="hero__actions">
                <!-- TODO: real phone number -->
                <a class="btn" href="tel:+17605550100">Call (760) 555-0100</a>
                <a class="btn btn--ghost" href="/contact/">Contact</a>
            </div>
        </div>
    </div>
</section>
