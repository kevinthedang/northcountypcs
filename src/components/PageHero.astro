---
interface Props {
    eyebrow: string;
    title: string;
    lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="hero hero--compact">
    <div class="wrap">
        <p class="hero__eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
    </div>
</section>
