---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';

const title = 'Custom PC Builds, Upgrades & Tune-Ups in Oceanside, CA | North County PCs';
const description =
    'Custom PC builds, SSD and RAM upgrades, and fresh Windows installs in Oceanside, California. Free first look, honest quotes, drop-off or on-site service across North County.';
const ogTitle = 'Custom PC Builds, Upgrades & Tune-Ups in Oceanside, CA';

const schema = {
    '@context': 'https://schema.org',
    '@type': 'ComputerStore',
    '@id': 'https://northcountypcs.com/#business',
    name: 'North County PCs',
    description:
        'Custom computer builds, hardware upgrades, and tune-ups serving Oceanside and North County, California.',
    url: 'https://northcountypcs.com/',
    telephone: '+1-760-555-0100',
    email: 'hello@northcountypcs.com',
    priceRange: '$$',
    address: {
        '@type': 'PostalAddress',
        addressLocality: 'Oceanside',
        addressRegion: 'CA',
        addressCountry: 'US',
    },
    areaServed: [
        { '@type': 'City', name: 'Oceanside' },
        { '@type': 'City', name: 'Carlsbad' },
        { '@type': 'City', name: 'Vista' },
        { '@type': 'City', name: 'San Marcos' },
        { '@type': 'City', name: 'Encinitas' },
        { '@type': 'City', name: 'Escondido' },
        { '@type': 'City', name: 'Fallbrook' },
    ],
    makesOffer: [
        {
            '@type': 'Offer',
            name: 'Quick diagnostic',
            price: '0',
            priceCurrency: 'USD',
            description:
                'Free initial check of power, boot, and obvious hardware or software faults.',
        },
        {
            '@type': 'Offer',
            name: 'Full diagnostic',
            price: '49',
            priceCurrency: 'USD',
            description:
                'Bench testing with a written quote before any work begins. Credited toward the repair if the quote is accepted.',
        },
    ],
};
---

<BaseLayout title={title} description={description} ogTitle={ogTitle}>
    <Fragment slot="head">
        <!-- TODO: replace telephone, email, and priceRange with your real details before launch -->
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema, null, 4)} />
    </Fragment>

    <section class="hero">
        <div class="wrap">
            <p class="hero__eyebrow">Locally owned &middot; By appointment</p>
            <h1>Custom PC builds, upgrades, and tune-ups in Oceanside.</h1>
            <p class="lead">
                Slow machine, full drive, or a build you'd rather not assemble yourself?
                I'll tell you honestly whether an upgrade is worth it &mdash; and quote it in
                plain English before any work starts.
            </p>
            <div class="hero__actions">
                <!-- TODO: real phone number -->
                <a class="btn" href="tel:+17605550100">Call (760) 555-0100</a>
                <!-- TODO: real email address -->
                <a
                    class="btn btn--ghost"
                    href="mailto:hello@northcountypcs.com?subject=Build%20or%20upgrade%20request"
                >
                    Email about your PC
                </a>
            </div>
            <p class="hero__note">
                Free initial check &middot; Full diagnostic only if needed &middot; No work
                without your approval
            </p>
        </div>
    </section>

    <section id="services">
        <div class="wrap">
            <div class="section__head">
                <h2>What I work on</h2>
                <p>
                    Desktops and laptops, home and small business. Builds, upgrades, and clean
                    installs done carefully &mdash; plus a straight answer on whether the
                    machine is worth it.
                </p>
            </div>

            <ul class="cards">
                <li class="card">
                    <h3><a href="/services/#custom-builds">Custom PC builds</a></h3>
                    <p>
                        Gaming rigs, workstations, and budget office machines specced to what you
                        actually do &mdash; assembled, cable-managed, and stress-tested before
                        pickup.
                    </p>
                </li>
                <li class="card">
                    <h3><a href="/services/#upgrades">Upgrades</a></h3>
                    <p>
                        SSD and RAM upgrades, GPU installs, PSU replacements, cooling fixes.
                        Usually the cheapest way to make an older machine feel new again.
                    </p>
                </li>
                <li class="card">
                    <h3><a href="/services/#tune-ups">Tune-ups &amp; installs</a></h3>
                    <p>
                        Dust and thermal paste, a clean Windows install, drivers, and moving
                        your files to a new drive. The difference is usually dramatic.
                    </p>
                </li>
                <li class="card">
                    <h3><a href="/services/#diagnostics">Diagnostics &amp; advice</a></h3>
                    <p>
                        Not sure if it's worth upgrading or replacing? Bring it in for a look.
                        I'll tell you what I think is wrong, what I can fix, and what's beyond
                        me.
                    </p>
                </li>
            </ul>
            <p class="services__note">
                Board-level repair and data recovery from failed drives I refer out to
                specialists &mdash; those are jobs you only get one shot at.
            </p>
        </div>
    </section>

    <section class="ethos" aria-labelledby="ethos-heading">
        <div class="wrap">
            <p class="ethos__eyebrow">Repair first</p>
            <h2 id="ethos-heading">I'd rather save your machine than sell you a new one.</h2>
            <p class="ethos__body">
                There's already too much e-waste in the world. If a new SSD buys your laptop
                another three years, that's the answer you'll get &mdash; even though a new
                build is the bigger sale. When replacement really is the right call, I'll
                tell you straight, but I won't invent a reason to sell you one.
            </p>
            <p class="ethos__note">
                I'm self-taught, building this up one machine at a time. So I'm careful, I
                check my work twice, and if a job is outside what I can do well, I'll tell
                you &mdash; I won't learn on your machine.
            </p>
        </div>
    </section>

    <Cta />
</BaseLayout>
